<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Add Bounding Box Info</name>
  <id>add.bbox.info</id>
  <effect>
    <effects-menu>
      <submenu name="Custom Tools"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">boundingBoxInfo.py</command>
  </script>
</inkscape-extension>
